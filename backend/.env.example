PORT=4000

# Samakan dengan koneksi database di db_greenersfix.sql
PGHOST=localhost
PGPORT=5432
PGDATABASE=greenersfix
PGUSER=postgres
PGPASSWORD=postgres

# Origin frontend Vite (dev server)
CORS_ORIGIN=http://localhost:5173

# =====================================================
# MQTT
# Harus SAMA PERSIS dengan yang dipakai di ESP_penerima.ino
# =====================================================
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=greenrss-backend

MQTT_TOPIC_SENSOR=greenhouse/sensors
MQTT_TOPIC_KIPAS=greenhouse/actuators/kipas/set
MQTT_TOPIC_LAMPU=greenhouse/actuators/lampu/set
MQTT_TOPIC_POMPA_AIR=greenhouse/actuators/pompaAir/set
MQTT_TOPIC_POMPA_NUTRISI=greenhouse/actuators/pompaNutrisi/set
